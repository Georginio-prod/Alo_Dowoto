// Schéma de persistance WorkTogo (#45).
//
// Depuis #218, la partie authentification (User, Session, OtpCode,
// VerifiedContact) est réellement branchée à l'application via
// server/utils/prisma.ts : les comptes, sessions et codes OTP survivent aux
// redémarrages du serveur. Les autres modèles (secteurs, profils
// prestataires, abonnements, paiements) documentent et préparent la bascule
// des stores en mémoire restants (chantier #46).
//
// Un aperçu du schéma sous forme de diagramme se trouve dans
// docs/database-schema.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  prestataire
}

enum SubscriptionStatus {
  en_attente
  actif
  expire
}

enum PaymentProvider {
  flooz
  tmoney
}

enum PaymentStatus {
  pending
  confirmed
  failed
}

/// Type de mouvement du portefeuille interne — voir server/utils/walletStore.ts (#192).
enum WalletMovementType {
  recharge
  escrow_debit
  escrow_release
  escrow_refund
  commission
  retrait
  /// Indemnisation du prestataire en cas d'annulation client après le délai
  /// de grâce (#275) — présent dans le store mais manquait à l'enum.
  cancellation_compensation
  /// Pénalité prélevée sur le solde du prestataire (débit) quand un litige
  /// se résout en sa défaveur — voir escrowDisputeResolution.ts.
  dispute_penalty
  /// Contrepartie (crédit) de dispute_penalty : versée au chercheur en plus
  /// du remboursement intégral du séquestre.
  dispute_compensation
}

/// Cycle de vie d'une commande en séquestre — voir server/utils/escrowOrderStore.ts (#194-#197).
enum EscrowOrderStatus {
  awaiting_payment
  in_escrow
  delivered
  released
  refunded
  disputed
}

/// Compte utilisateur (client ou prestataire) — voir server/utils/userStore.ts.
model User {
  id        String   @id @default(uuid())
  contact   String   @unique
  role      Role
  createdAt DateTime @default(now())

  /// Hash scrypt (server/utils/password.ts) — null tant que l'inscription
  /// n'est pas finalisée (#125).
  passwordHash String?

  /// Identifiant Google (`sub` OpenID Connect) lié au compte — permet la
  /// connexion « Continuer avec Google » (#219). Lié automatiquement au
  /// premier login Google d'un compte existant avec le même email.
  googleId String? @unique

  /// Profil collecté dès la première page d'inscription (#125).
  username  String @default("")
  firstName String @default("")
  lastName  String @default("")
  location  String @default("")

  /// Coordonnées GPS réelles, capturées en option à l'inscription via la
  /// géolocalisation du navigateur (bouton « Utiliser ma position actuelle »)
  /// — contrairement à `location` (ville en texte libre, saisie ou déduite
  /// par géocodage inverse), ce sont des coordonnées exactes. `null` si
  /// l'utilisateur n'a pas utilisé/autorisé l'option.
  latitude  Float?
  longitude Float?

  sessions        Session[]
  providerProfile ProviderProfile?
  subscriptions   Subscription[]
  payments        Payment[]
  reviewsWritten  Review[]         @relation("ReviewAuthor")
}

/// Session authentifiée (cookie wt_session) — voir server/utils/userStore.ts (#218).
model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Code OTP en attente de vérification pour un contact (téléphone/email
/// normalisé) — voir server/utils/otpStore.ts (#23, #218).
model OtpCode {
  contact    String   @id
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime
}

/// Preuve (à usage unique) qu'un contact vient de valider son code OTP,
/// consommée à la création de session — voir server/utils/otpStore.ts (#24, #218).
model VerifiedContact {
  contact   String   @id
  expiresAt DateTime
}

/// Secteur d'activité — voir app/data/sectors.ts (#8).
model Sector {
  id    String @id @default(uuid())
  slug  String @unique
  name  String
  emoji String
  color String
  ink   String

  subSectors       SubSector[]
  providerProfiles ProviderProfile[]
}

/// Sous-secteur rattaché à un secteur — voir app/data/sectors.ts (#8).
model SubSector {
  id       String  @id @default(uuid())
  name     String
  icon     String?
  sectorId String
  sector   Sector  @relation(fields: [sectorId], references: [id])

  providerProfiles ProviderProfile[]

  @@unique([sectorId, name])
}

/// Profil public d'un prestataire — voir server/utils/providerStore.ts (#26, #27).
model ProviderProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id])
  displayName   String
  sectorId      String
  sector        Sector     @relation(fields: [sectorId], references: [id])
  subSectorId   String?
  subSector     SubSector? @relation(fields: [subSectorId], references: [id])
  city          String?
  description   String?
  photoUrl      String?
  rateFrom      Int?
  verified      Boolean    @default(false)
  ratingAverage Float      @default(0)
  reviewCount   Int        @default(0)
  updatedAt     DateTime   @updatedAt

  /// Coordonnées réelles de la zone d'intervention (#263) — déjà présentes côté
  /// store en mémoire (server/utils/providerStore.ts), ajoutées ici pour que ce
  /// modèle préparatoire ne diverge plus du store qu'il documente.
  latitude  Float?
  longitude Float?
  /// Slug d'un quartier de app/data/regions.ts (#geoloc), complète `city`.
  quartier  String?
  /// Texte libre, jamais une adresse postale fiable au Togo (voir app/data/regions.ts).
  adresse   String?
  /// Repère local en texte libre (« près du grand marché »...), affiché sur le profil.
  pointsDeRepere      String?
  /// Distance maximale (km) que le prestataire accepte de parcourir pour intervenir.
  rayonInterventionKm Int?
  /// `true` (défaut) : seule une position floutée est exposée publiquement — voir
  /// server/utils/geo.ts#fuzzCoordinate et providerDirectory.ts#toSearchResult.
  positionApproximative Boolean @default(true)

  reviews Review[]

  @@index([sectorId, city])
}

/// Avis client sur un prestataire — nouveau modèle, pas encore d'équivalent
/// en mémoire (aucune route API d'avis dans le lot actuel).
model Review {
  id         String          @id @default(uuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  authorId   String
  author     User            @relation("ReviewAuthor", fields: [authorId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([providerId])
}

/// Abonnement prestataire — voir server/utils/subscriptionStore.ts (#29, #30).
model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  plan      String
  status    SubscriptionStatus @default(en_attente)
  dateDebut DateTime?
  dateFin   DateTime?
  createdAt DateTime           @default(now())
  /// `true` si la période active courante est l'essai gratuit (#281), pas une
  /// période payée — voir server/utils/subscriptionStore.ts.
  isTrial   Boolean            @default(false)

  payments Payment[]
}

/// Paiement Mobile Money lié à un abonnement — voir server/utils/paymentStore.ts (#32, #34).
model Payment {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  provider       PaymentProvider
  phone          String
  amount         Int
  status         PaymentStatus   @default(pending)
  operatorRef    String?
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// Cœur métier encore en mémoire (#46) : portefeuille, séquestre et messagerie.
//
// Ces modèles préparent la bascule des stores en mémoire correspondants
// (walletStore, escrowOrderStore, conversationStore) vers la base — ils ne
// sont pas encore lus/écrits par l'application (le wiring est un chantier de
// suivi, à réaliser une fois la cible d'hébergement/base tranchée). Ils sont
// modélisés fidèlement à la forme actuelle des stores pour servir de socle.
// ---------------------------------------------------------------------------

/// Mouvement (append-only) du portefeuille interne — voir server/utils/walletStore.ts (#192).
/// Le solde n'est jamais stocké : il se recalcule à partir de ces mouvements.
model WalletMovement {
  id                 String             @id @default(uuid())
  /// Titulaire du portefeuille (id utilisateur, ou PLATFORM_WALLET_USER_ID pour la plateforme).
  walletUserId       String
  type               WalletMovementType
  /// Toujours positif ; le sens (crédit/débit) dépend uniquement de `type`.
  amount             Int
  /// Référence externe (id paiement mobile money) ou interne (id commande séquestre).
  reference          String
  /// Autre utilisateur concerné quand pertinent (ex. le prestataire payé).
  counterpartyUserId String?
  createdAt          DateTime           @default(now())

  @@index([walletUserId])
}

/// Commande en séquestre liée à une conversation — voir server/utils/escrowOrderStore.ts (#194-#197).
model EscrowOrder {
  id            String            @id @default(uuid())
  conversationId String           @unique
  clientId      String
  providerId    String
  amount        Int
  status        EscrowOrderStatus @default(awaiting_payment)
  createdAt     DateTime          @default(now())
  paidAt        DateTime?
  deliveredAt   DateTime?
  releasedAt    DateTime?
  cancelledAt   DateTime?
  /// Motif obligatoire de l'annulation prestataire (#196).
  cancelReason  String?
  disputedAt    DateTime?
  /// Motif du litige ouvert par le chercheur (#197).
  disputeReason String?
  /// Preuves fournies par le chercheur à l'ouverture du litige (#274).
  disputeEvidence    String?
  /// Réponse du prestataire au litige (#274, « en médiation »).
  disputeResponse    String?
  disputeRespondedAt DateTime?
  /// Preuve d'intervention in-app (#268) : arrivée puis départ du lieu.
  /// La géolocalisation (lat/lng) est enregistrée quand le navigateur
  /// l'autorise, sinon null — c'est l'existence des horodatages qui fait foi.
  checkInAt     DateTime?
  checkInLat    Float?
  checkInLng    Float?
  checkOutAt    DateTime?
  checkOutLat   Float?
  checkOutLng   Float?

  @@index([status])
}

/// Recharge du portefeuille via mobile money — voir server/utils/walletRechargeStore.ts (#193).
/// Réutilise les enums PaymentProvider/PaymentStatus (mêmes valeurs que les paiements).
model WalletRecharge {
  id          String          @id @default(uuid())
  userId      String
  provider    PaymentProvider
  phone       String
  amount      Int
  status      PaymentStatus   @default(pending)
  operatorRef String?
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?

  @@index([userId])
}

/// Type de message d'un fil — voir server/utils/conversationStore.ts (#357, ADR 0013 étape 6).
/// `order_confirmation`/`location_request`/`reschedule_request` sont des messages
/// actionnables (voir Message.resolvedAt) ; `location_shared` porte des coordonnées
/// (Message.locationLat/Lng) ; `text` est un message classique.
enum MessageKind {
  text
  order_confirmation
  location_request
  location_shared
  reschedule_request
}

/// Émetteur d'un message — distinct de `Role` (User.role) : `system` désigne un
/// message automatique WorkTogo, jamais un vrai compte (voir WORKTOGO_SYSTEM_SENDER_ID).
enum MessageSenderRole {
  client
  prestataire
  system
}

/// Fil de messagerie entre un client et un prestataire — voir server/utils/conversationStore.ts (#59, #129).
model Conversation {
  id               String    @id @default(uuid())
  clientId         String
  providerId       String
  /// Formulaire obligatoire de première prise de contact déjà soumis (#129) ?
  firstContactDone Boolean   @default(false)
  /// Coordonnées brutes du chercheur transmises au premier contact (#129),
  /// jamais exposées telles quelles dans un message avant validation finale
  /// (`released`, #264 anti-fuite).
  clientContact    String?
  createdAt        DateTime  @default(now())

  messages Message[]
  reads    ConversationRead[]

  @@unique([clientId, providerId])
}

/// Message d'un fil de conversation — voir server/utils/conversationStore.ts (#59).
model Message {
  id             String            @id @default(uuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     MessageSenderRole
  body           String
  kind           MessageKind       @default(text)
  /// Coordonnées d'un message `location_shared`, sinon `null`.
  locationLat    Float?
  locationLng    Float?
  /// Horodatage du créneau proposé pour un message `reschedule_request` (#270), sinon `null`.
  proposedAt     DateTime?
  /// Horodatage de la réponse à un message actionnable, sinon `null` (non résolu).
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
}

/// Dernière lecture d'un fil par un utilisateur (compteur de non-lus, #225).
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime

  @@id([conversationId, userId])
}

/// Favori client → prestataire (#65, #357). Pas de clé étrangère : un
/// prestataire peut être une fiche de l'annuaire de démonstration (pas un
/// compte User). La clé primaire composite garantit l'idempotence.
model Favorite {
  clientId   String
  providerId String
  createdAt  DateTime @default(now())

  @@id([clientId, providerId])
  @@index([clientId])
}

/// Réclamation déposée depuis /reclamation (#357). Pas de clé étrangère :
/// `userId` est null pour une réclamation déposée sans compte connecté.
model Complaint {
  id           String   @id @default(uuid())
  category     String
  subject      String
  message      String
  contactEmail String
  userId       String?
  createdAt    DateTime @default(now())
}

/// Journal des tentatives de contournement détectées dans la messagerie
/// (#265, #357) — pour identifier des comptes récidivistes côté support.
model ContournementAttempt {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  reason         String
  /// Extrait tronqué du message bloqué (audit) — jamais le message intégral.
  excerpt        String
  createdAt      DateTime @default(now())

  @@index([userId])
}

/// Avis libre affiché sur la page d'accueil (#357). Distinct des notations de
/// collaboration (modèle Review) : n'importe quel visiteur peut partager son
/// expérience générale, sans compte ni conversation. Les avis d'exemple
/// (seeds) restent des constantes de code, fusionnés à la lecture.
model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  message   String
  rating    Int
  createdAt DateTime @default(now())
}

/// Type d'événement notifié — un seul cas pour l'instant (#360, premier
/// incrément) ; les événements paiement/escrow/litige de l'issue restent à
/// ajouter dans un incrément ultérieur, même patron que les autres enums
/// d'événement (MessageKind).
enum NotificationType {
  new_message
  /// Mise à jour d'un litige escrow (réponse du prestataire, résolution) — voir escrowDisputeResolution.ts.
  dispute_update
}

/// Notification in-app (#360, centre de notifications — premier incrément :
/// nouveau message reçu, côté chercheur comme prestataire). Pas de clé
/// étrangère vers User (même choix que Favorite/Complaint) : `userId` peut
/// référencer un compte réel ou, côté prestataire, un id de l'annuaire de
/// démo tant que ce dernier n'est pas remplacé par de vrais comptes (voir
/// conversationStore.ts).
model Notification {
  id             String           @id @default(uuid())
  userId         String
  type           NotificationType
  title          String
  body           String
  /// Conversation à ouvrir au clic, quand pertinent (toujours le cas pour `new_message`).
  conversationId String?
  /// `null` tant que non lue.
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
}
