# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Secrets / credentials (jamais versionner — le dépôt est public)
*.pem
*.key
*.p12
*.pfx
**/*service*account*.json
**/*credential*.json
secrets/

# Scheduler lock file
.claude/scheduled_tasks.lock

# Worktrees d'agents (copies complètes du dépôt, jamais versionnées)
.claude/worktrees/

# Artefacts de compilation TypeScript émis à côté des sources — le projet est
# 100% .ts/.vue, tout .js sous app/ ou server/ est une sortie de build
# accidentelle (tsc sans --noEmit) et ne doit jamais être committé.
app/**/*.js
server/**/*.js

# Base SQLite locale (Prisma) — voir prisma/migrations pour le schéma versionné
prisma/dev.db
prisma/dev.db-journal
tests/setup/test.db
tests/setup/test.db-journal

# Base éphémère de prisma migrate diff
shadow.db

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
# Base SQLite jetable des tests de parcours (voir e2e/global-setup.ts)
/e2e/.tmp/
