# Copier vers .env (non committé). AUCUN secret ici.
# URL du backend Nuxt (le site). Le serveur écoute sur le port 3000.
# - Émulateur/simulateur sur le même PC : http://localhost:3000
# - TÉLÉPHONE RÉEL : mettre l'IP LAN du PC (pas localhost !), ex. ci-dessous.
#   Trouver l'IP : `ipconfig` (Windows) -> "Adresse IPv4".
#   Le téléphone doit être sur le même Wi-Fi, et le serveur lancé avec --host.
EXPO_PUBLIC_API_URL=http://192.168.1.174:3000

# DSN Sentry public (client) — vide = reporting désactivé.
EXPO_PUBLIC_SENTRY_DSN=

# Identifiant projet EAS (rempli par `eas init`).
EAS_PROJECT_ID=
