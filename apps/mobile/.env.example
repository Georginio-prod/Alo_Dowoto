# Copier vers .env (non committé). AUCUN secret ici.
# URL du backend Nuxt (site web). En dev, l'IP LAN du poste pour tester sur un
# téléphone réel, ex. http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# DSN Sentry public (client) — laissé vide désactive le reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Identifiant projet EAS (rempli par `eas init`).
EAS_PROJECT_ID=
