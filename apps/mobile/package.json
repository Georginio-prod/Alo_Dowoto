{
  "name": "worktogo-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 3000",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 3000",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "build:preview": "eas build --platform android --profile preview",
    "build:prod": "eas build --platform android --profile production"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-router": "~6.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-localization": "~17.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-image": "~3.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.0",
    "expo-status-bar": "~3.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-haptics": "~15.0.0",
    "expo-network": "~8.0.0",
    "expo-font": "~14.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "react-native-web": "~0.21.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "lottie-react-native": "7.3.1",
    "@tanstack/react-query": "^5.62.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-mmkv": "^3.1.0",
    "zustand": "^5.0.2",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.1",
    "zod": "^3.24.1",
    "i18next": "^24.2.0",
    "react-i18next": "^15.4.0",
    "@sentry/react-native": "~6.10.0",
    "@expo-google-fonts/poppins": "^0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.0",
    "@types/jest": "^29.5.14",
    "typescript": "~5.9.0",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "@testing-library/react-native": "^13.0.0",
    "@testing-library/jest-native": "^5.4.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/.*|native-base|react-native-svg|@tanstack/.*))"
    ],
    "collectCoverageFrom": [
      "src/features/**/utils.ts",
      "src/lib/**/*.ts",
      "src/design-system/**/*.ts"
    ]
  }
}
