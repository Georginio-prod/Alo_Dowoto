/// Schéma de persistance de WorkTogo.
/// Les modèles documentent les données métier et leurs contraintes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  prestataire
  /// Compte administrateur, créé uniquement par un flux d'administration.
  admin
}

/// Statut du compte utilisateur.
enum UserStatus {
  active
  suspended
}

/// Décision administrative concernant une vérification d'identité.
enum KycDecisionStatus {
  approved
  rejected
}

enum SubscriptionStatus {
  en_attente
  actif
  expire
}

enum PaymentProvider {
  flooz
  tmoney
}

enum PaymentStatus {
  pending
  confirmed
  failed
}

/// Type de mouvement du portefeuille interne.
enum WalletMovementType {
  recharge
  escrow_debit
  escrow_release
  escrow_refund
  commission
  retrait
  /// Indemnisation du prestataire après une annulation client tardive.
  cancellation_compensation
  /// Pénalité prélevée sur le solde du prestataire après un litige perdu.
  dispute_penalty
  /// Crédit versé au chercheur en contrepartie de la pénalité.
  dispute_compensation
  /// Bonus crédité au parrain et au filleul lors du premier paiement réel.
  referral_bonus
}

/// Statut d'un parrainage.
enum ReferralStatus {
  /// Filleul inscrit, sans paiement réel.
  pending
  /// Bonus crédité aux deux comptes, état terminal.
  rewarded
}

/// Cycle de vie d'une commande en séquestre.
enum EscrowOrderStatus {
  awaiting_payment
  in_escrow
  delivered
  released
  refunded
  disputed
}

/// Compte utilisateur.
model User {
  id        String   @id @default(uuid())
  contact   String   @unique
  role      Role
  createdAt DateTime @default(now())

  /// Hash scrypt du mot de passe, absent tant que l'inscription n'est pas finalisée.
  passwordHash String?

  /// Identifiant Google OpenID Connect, lorsqu'un compte est lié à Google.
  googleId String? @unique

  /// Informations de profil collectées lors de l'inscription.
  username  String @default("")
  firstName String @default("")
  lastName  String @default("")
  location  String @default("")

  /// Coordonnées GPS précises, facultatives et distinctes de la ville textuelle.
  latitude  Float?
  longitude Float?

  /// Permissions d'administration sérialisées en JSON.
  /// `null` représente un administrateur sans restriction.
  adminPermissions String?

  /// Code de parrainage, généré à la demande pour les anciens comptes.
  referralCode String? @unique

  /// Statut de compte et informations liées à une suspension.
  status              UserStatus @default(active)
  suspendedAt         DateTime?
  suspendedReason     String?
  /// Compte signalé comme présentant un risque.
  riskFlag            Boolean    @default(false)
  riskNote            String?
  /// Interdit l'initialisation de nouveaux fils de messagerie.
  messagingRestricted Boolean    @default(false)
  /// Niveau d'accès d'un administrateur.
  adminLevel          String?

  sessions         Session[]
  providerProfile  ProviderProfile?
  subscriptions    Subscription[]
  payments         Payment[]
  referralsMade    Referral[]       @relation("ReferralsMade")
  referralReceived Referral?        @relation("ReferralReceived")
}

/// Parrainage : un filleul a un seul parrain, tandis qu'un parrain peut
/// avoir plusieurs filleuls. La récompense intervient au premier paiement réel.
model Referral {
  id         String         @id @default(uuid())
  referrerId String
  referrer   User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String         @unique
  referred   User           @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)
  status     ReferralStatus @default(pending)
  createdAt  DateTime       @default(now())
  rewardedAt DateTime?

  @@index([referrerId])
}

/// Session authentifiée.
model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Code OTP en attente de vérification pour un contact normalisé.
model OtpCode {
  contact    String   @id
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime
}

/// Preuve à usage unique de validation d'un code OTP.
model VerifiedContact {
  contact   String   @id
  expiresAt DateTime
}

/// Secteur d'activité.
model Sector {
  id     String  @id @default(uuid())
  slug   String  @unique
  name   String
  emoji  String
  color  String
  ink    String
  /// Une catégorie inactive n'est plus proposée dans les nouvelles fiches.
  active Boolean @default(true)
  /// Ordre d'affichage croissant.
  order  Int     @default(0)

  subSectors         SubSector[]
  providerProfiles   ProviderProfile[]
  prealableQuestions PrealableQuestion[]
}

/// Sous-secteur rattaché à un secteur.
model SubSector {
  id       String  @id @default(uuid())
  name     String
  icon     String?
  sectorId String
  sector   Sector  @relation(fields: [sectorId], references: [id])

  providerProfiles ProviderProfile[]

  @@unique([sectorId, name])
}

/// Profil public d'un prestataire.
model ProviderProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id])
  displayName   String
  sectorId      String
  sector        Sector     @relation(fields: [sectorId], references: [id])
  subSectorId   String?
  subSector     SubSector? @relation(fields: [subSectorId], references: [id])
  city          String?
  description   String?
  photoUrl      String?
  rateFrom      Int?
  verified      Boolean    @default(false)
  ratingAverage Float      @default(0)
  reviewCount   Int        @default(0)
  updatedAt     DateTime   @updatedAt

  /// Coordonnées réelles de la zone d'intervention.
  latitude              Float?
  longitude             Float?
  /// Slug du quartier, en complément de `city`.
  quartier              String?
  /// Adresse libre, qui ne constitue pas une adresse postale fiable.
  adresse               String?
  /// Repère local affiché sur le profil.
  pointsDeRepere        String?
  /// Distance maximale d'intervention, en kilomètres.
  rayonInterventionKm   Int?
  /// `true` par défaut : seule une position approximative est exposée publiquement.
  positionApproximative Boolean @default(true)

  /// Champs complémentaires du profil professionnel.
  /// Mode de rémunération : flooz, tmoney ou virement.
  payoutMethod   String?
  /// Tarif maximal en FCFA, en complément de `rateFrom`.
  rateTo         Int?
  /// Mobilité : client, atelier ou les deux.
  mobility       String?
  /// Disponibilité en texte libre.
  availability   String?
  cvUrl          String?
  cvFileName     String?
  whatsapp       String?
  website        String?
  /// Listes sérialisées en JSON.
  languages      String?
  formations     String?
  certifications String?

  @@index([sectorId, city])
}

/// Avis laissé après une collaboration.
/// Chaque auteur ne peut noter qu'une fois une conversation.
model Review {
  id             String   @id @default(uuid())
  conversationId String
  authorId       String
  targetId       String
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  @@unique([conversationId, authorId])
  @@index([targetId])
}

/// Abonnement d'un prestataire.
model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  plan      String
  status    SubscriptionStatus @default(en_attente)
  dateDebut DateTime?
  dateFin   DateTime?
  createdAt DateTime           @default(now())
  /// `true` si la période active est un essai gratuit.
  isTrial   Boolean            @default(false)

  payments Payment[]
}

/// Paiement Mobile Money lié à un abonnement.
model Payment {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  provider       PaymentProvider
  phone          String
  amount         Int
  status         PaymentStatus   @default(pending)
  operatorRef    String?
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  @@index([subscriptionId])
}

/// Portefeuille, séquestre et messagerie.

/// Mouvement append-only du portefeuille interne.
/// Le solde se recalcule à partir de ces mouvements.
model WalletMovement {
  id                 String             @id @default(uuid())
  /// Titulaire du portefeuille, ou identifiant du portefeuille de la plateforme.
  walletUserId       String
  type               WalletMovementType
  /// Montant toujours positif ; le sens dépend de `type`.
  amount             Int
  /// Référence d'un paiement externe ou d'une commande interne.
  reference          String
  /// Autre utilisateur concerné, le cas échéant.
  counterpartyUserId String?
  createdAt          DateTime           @default(now())

  @@index([walletUserId])
}

/// Commande en séquestre liée à une conversation.
model EscrowOrder {
  id                 String            @id @default(uuid())
  conversationId     String            @unique
  clientId           String
  providerId         String
  amount             Int
  status             EscrowOrderStatus @default(awaiting_payment)
  createdAt          DateTime          @default(now())
  paidAt             DateTime?
  deliveredAt        DateTime?
  releasedAt         DateTime?
  cancelledAt        DateTime?
  /// Motif de l'annulation par le prestataire.
  cancelReason       String?
  disputedAt         DateTime?
  /// Motif du litige ouvert par le chercheur.
  disputeReason      String?
  /// Preuves fournies à l'ouverture du litige.
  disputeEvidence    String?
  /// Réponse du prestataire au litige.
  disputeResponse    String?
  disputeRespondedAt DateTime?
  /// Preuve d'intervention : arrivée puis départ du lieu.
  /// Les coordonnées sont facultatives ; les horodatages font foi.
  checkInAt          DateTime?
  checkInLat         Float?
  checkInLng         Float?
  checkOutAt         DateTime?
  checkOutLat        Float?
  checkOutLng        Float?

  @@index([status])
}

/// Recharge du portefeuille via Mobile Money.
model WalletRecharge {
  id          String          @id @default(uuid())
  userId      String
  provider    PaymentProvider
  phone       String
  amount      Int
  status      PaymentStatus   @default(pending)
  operatorRef String?
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?

  @@index([userId])
}

/// Type de message d'un fil.
/// Certains messages sont actionnables ou portent des coordonnées.
enum MessageKind {
  text
  order_confirmation
  location_request
  location_shared
  reschedule_request
}

/// Émetteur d'un message.
/// `system` désigne un message automatique, jamais un compte utilisateur.
enum MessageSenderRole {
  client
  prestataire
  system
}

/// Fil de messagerie entre un client et un prestataire.
model Conversation {
  id               String   @id @default(uuid())
  clientId         String
  providerId       String
  /// Indique si le formulaire de premier contact a été soumis.
  firstContactDone Boolean  @default(false)
  /// Coordonnées transmises au premier contact, masquées dans les messages
  /// jusqu'à la validation finale.
  clientContact    String?
  createdAt        DateTime @default(now())

  messages Message[]
  reads    ConversationRead[]

  @@unique([clientId, providerId])
}

/// Message d'un fil de conversation.
model Message {
  id                String            @id @default(uuid())
  conversationId    String
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String
  senderRole        MessageSenderRole
  /// Texte libre ou texte de repli français pour un message généré.
  body              String
  kind              MessageKind       @default(text)
  /// Clé i18n d'un message généré ; `null` pour un message libre.
  translationKey    String?
  /// Paramètres d'interpolation sérialisés en JSON.
  translationParams String?
  /// Coordonnées d'un message `location_shared`.
  locationLat       Float?
  locationLng       Float?
  /// Créneau proposé pour un message `reschedule_request`.
  proposedAt        DateTime?
  /// Date de résolution d'un message actionnable.
  resolvedAt        DateTime?
  createdAt         DateTime          @default(now())

  @@index([conversationId])
}

/// Dernière lecture d'un fil par un utilisateur.
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime

  @@id([conversationId, userId])
}

/// Favori client-prestataire.
/// La clé primaire composite garantit l'idempotence.
model Favorite {
  clientId   String
  providerId String
  createdAt  DateTime @default(now())

  @@id([clientId, providerId])
  @@index([clientId])
}

/// Réclamation déposée depuis le formulaire public.
/// `userId` est nul lorsqu'elle est déposée sans compte connecté.
model Complaint {
  id           String   @id @default(uuid())
  category     String
  subject      String
  message      String
  contactEmail String
  userId       String?
  createdAt    DateTime @default(now())

  /// Suivi interne du traitement de la réclamation.
  /// `adminNote` n'est jamais exposée publiquement.
  status      String    @default("nouveau")
  adminNote   String?
  handledAt   DateTime?
  handledById String?
}

/// Journal des tentatives de contournement détectées dans la messagerie.
model ContournementAttempt {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  reason         String
  /// Extrait tronqué du message bloqué, jamais le message intégral.
  excerpt        String
  createdAt      DateTime @default(now())

  @@index([userId])
}

/// Avis libre affiché sur la page d'accueil, sans compte ni conversation.
model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  message   String
  rating    Int
  createdAt DateTime @default(now())

  /// Masque l'avis de la page d'accueil sans le supprimer.
  hidden Boolean @default(false)
}

/// Type d'événement notifié.
enum NotificationType {
  new_message
  /// Mise à jour d'un litige (réponse du prestataire ou résolution).
  dispute_update
  /// Message ou annonce de l'équipe WorkTogo, sans conversation liée.
  admin_message
}

/// Notification in-app.
model Notification {
  id             String           @id @default(uuid())
  userId         String
  type           NotificationType
  title          String
  body           String
  /// Conversation à ouvrir au clic, le cas échéant.
  conversationId String?
  /// `null` tant que la notification n'est pas lue.
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
}

/// Nonce de webhook déjà consommé.
/// La clé primaire permet de détecter les rejeux par insertion unique.
model WebhookNonce {
  nonce     String   @id
  /// Instant à partir duquel le nonce peut être purgé.
  expiresAt DateTime

  @@index([expiresAt])
}

/// Compteur de débit de l'assistant IA par fenêtre fixe.
/// Une ligne est créée par clé et début de fenêtre.
model AiRateWindow {
  /// Utilisateur connecté ou visiteur anonyme.
  key         String
  /// Début de la fenêtre fixe.
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Données du dashboard d'administration.

/// Journal horodaté des actions sensibles effectuées par un administrateur.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorLabel String
  action     String
  targetType String
  targetId   String?
  /// Détail complémentaire sérialisé en JSON.
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Période d'indisponibilité déclarée par un prestataire.
/// Les dates sont au format ISO `AAAA-MM-JJ`, bornes incluses.
model UnavailabilityPeriod {
  id         String   @id @default(uuid())
  providerId String
  startDate  String
  endDate    String
  createdAt  DateTime @default(now())

  @@index([providerId])
}

/// Vérification d'identité, limitée à une soumission par utilisateur.
/// Les images sont supprimées après la période de conservation.
model Verification {
  userId             String    @id
  idCardImage        String?
  passportPhotoImage String?
  submittedAt        DateTime  @default(now())
  purgedAt           DateTime?
}

/// Décision administrative sur une vérification d'identité.
/// Plusieurs décisions peuvent être conservées pour un même utilisateur.
model KycDecision {
  id         String            @id @default(uuid())
  userId     String
  status     KycDecisionStatus
  reason     String?
  reviewedBy String
  reviewedAt DateTime          @default(now())

  @@index([userId])
}

/// Note interne, jamais exposée aux utilisateurs.
model AdminNote {
  id          String   @id @default(uuid())
  targetType  String
  targetId    String
  authorId    String
  authorLabel String
  body        String
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
}

/// Formule d'abonnement éditable par l'administration.
model SubscriptionPlanConfig {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  priceAmount    Int
  durationDays   Int
  commissionRate Float    @default(0.10)
  /// Avantages affichés, un par ligne.
  features       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Code promotionnel.
model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String
  discountValue Int
  active        Boolean   @default(true)
  expiresAt     DateTime?
  usageLimit    Int?
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
}

/// Réglages généraux de la plateforme.
/// Une seule ligne est conservée (`id = 1`).
model PlatformSettings {
  id                       Int      @id @default(1)
  geoRadiusKm              Int      @default(15)
  autoValidationDelayHours Int      @default(72)
  retractationDelayHours   Int      @default(24)
  currency                 String   @default("XOF")
  language                 String   @default("fr")
  minAdvanceAmount         Int      @default(1000)
  commissionRate           Float    @default(0.10)
  updatedAt                DateTime @updatedAt
}

/// État de modération d'un avis.
model ReviewModeration {
  reviewId     String    @id
  hidden       Boolean   @default(false)
  hiddenReason String?
  flagged      Boolean   @default(false)
  flagReason   String?
  restoredAt   DateTime?
  updatedAt    DateTime  @updatedAt
}

/// Signalement anti-désintermédiation marqué comme faux positif.
model RiskFalsePositive {
  userId   String   @id
  markedBy String
  markedAt DateTime @default(now())
  note     String?
}

/// Bloc de contenu éditable des pages publiques.
model SiteContent {
  key       String   @id
  label     String
  value     String
  updatedAt DateTime @updatedAt
}

/// Question préalable propre à une catégorie de service.
model PrealableQuestion {
  id       String  @id @default(uuid())
  sectorId String
  sector   Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  label    String
  order    Int     @default(0)
  required Boolean @default(true)

  @@index([sectorId])
}

/// Modèle de message automatique éditable.
model MessageTemplate {
  key       String   @id
  label     String
  channel   String
  subject   String?
  body      String
  updatedAt DateTime @updatedAt
}

/// Campagne de notification envoyée à un segment d'utilisateurs.
model NotificationCampaign {
  id             String    @id @default(uuid())
  segment        String
  channel        String
  subject        String?
  body           String
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  openCount      Int       @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
}
