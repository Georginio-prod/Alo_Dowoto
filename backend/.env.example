# Port d'écoute de l'API backend
PORT=3001

# Environnement (development | production | test)
NODE_ENV=development

# Origines autorisées pour CORS, séparées par des virgules.
# Les trois clients de l'API : site web, dashboard admin, app mobile.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sentry (optionnel) — laissé vide = instrumentation désactivée.
SENTRY_DSN=

# Secret HMAC partagé pour signer/vérifier les webhooks opérateur (recharge #193,
# paiement #34). OBLIGATOIRE en production (sinon le backend refuse de démarrer le
# traitement d'un webhook) ; hors production, repli sur un secret de dev connu.
PAYMENT_WEBHOOK_SECRET=

# Expose la doc OpenAPI sur /api/docs (UI) et /api/docs.json (spec).
# Vide = activée hors production, désactivée en production. Forcer avec 1/true ou 0/false.
API_DOCS_ENABLED=

# Base PostgreSQL canonique (conteneur Docker, docker-compose.yml racine,
# port hôte 5433). Le backend possède le schéma et les migrations.
DATABASE_URL=postgresql://worktogo:worktogo@localhost:5433/worktogo?schema=public

# OAuth Google (optionnel). Déclarer `<origine>/api/auth/google/callback` dans
# Google Cloud pour l'environnement concerné.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi OTP : sans ces valeurs, le code reste disponible en développement.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
BREVO_API_KEY=
BREVO_SMS_SENDER=
EMAIL_FROM=
EMAIL_FROM_NAME=WorkTogo

# Assistant IA (optionnel : repli FAQ déterministe sans clé).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_LIGHT=claude-haiku-4-5-20251001
AI_MODEL_HEAVY=claude-sonnet-5

# Relais des mises à jour du dashboard desktop (lecture seule, optionnel).
GITHUB_UPDATE_TOKEN=
GITHUB_UPDATE_REPO=Nova2026-graphik/worktogo-admin
