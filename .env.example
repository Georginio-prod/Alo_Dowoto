# Copier ce fichier en .env pour le développement local.
# Ne JAMAIS committer un .env réel ni de vraies valeurs de secrets — ce
# fichier ne contient que des noms de variables et des placeholders (voir
# docs/deployment.md pour la gestion des secrets en CI/CD, #47).

# --- Base de données (Prisma, voir docs/database-schema.md, #45) ---
DATABASE_URL="file:./dev.db"

# --- Connexion avec Google / OAuth 2.0 (#219, voir server/api/auth/google/*) ---
# Identifiants d'un client OAuth « Application Web » créé dans Google Cloud
# Console (APIs & Services > Credentials > Create credentials > OAuth client ID).
# URI de redirection autorisée à déclarer côté Google :
#   http://localhost:3000/api/auth/google/callback  (dev)
#   https://<votre-domaine>/api/auth/google/callback (prod)
# Sans ces deux valeurs, le bouton « Continuer avec Google » renvoie
# /auth?error=google_config (le reste de l'auth par OTP reste fonctionnel).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Paiements mobile money (Flooz / T-Money, voir server/api/payments/*, #34) ---

# Utilisé dès aujourd'hui pour signer/vérifier le webhook de paiement
# (server/utils/webhookSignature.ts). En l'absence de valeur, un secret de
# développement par défaut est utilisé (jamais en production).
PAYMENT_WEBHOOK_SECRET=

# Prévu pour : identifiants des comptes marchands Flooz/T-Money une fois
# l'intégration sandbox/réelle branchée (server/api/payments/initiate.post.ts
# simule actuellement la confirmation opérateur, faute d'accès sandbox — voir
# le commentaire "#34"). Pas encore lus par le code à ce jour.
FLOOZ_API_KEY=
TMONEY_API_KEY=

# --- SMS / OTP (voir server/utils/sms.ts et server/api/auth/otp/send.post.ts, #23) ---

# Provider SMS pour l'envoi réel des codes OTP (driver Twilio, couvre les
# numéros togolais +228). Si ces trois variables sont définies, le code OTP
# part par SMS ; sinon, repli développement (code journalisé côté serveur et
# renvoyé en clair hors production pour permettre de tester le parcours).
# TWILIO_FROM : numéro expéditeur E.164 acheté chez Twilio (ex. +1...) ou
# SID d'un Messaging Service (commence par "MG").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email / OTP (voir server/utils/email.ts, #23) ---

# Provider email pour l'envoi réel des codes OTP (driver Brevo, gratuit
# jusqu'à 300 emails/jour). Si BREVO_API_KEY et EMAIL_FROM sont définis, le
# code OTP part par email ; sinon, même repli développement que pour le SMS.
# EMAIL_FROM doit être une adresse expéditrice vérifiée dans Brevo
# (Senders & Domains > Senders). EMAIL_FROM_NAME est optionnel ("WorkTogo").
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# --- Assistant IA (#geoloc, voir server/utils/ai/index.ts) ---

# Fournisseur actif. Seul 'anthropic' est implémenté pour l'instant — inutile
# de la définir tant que vous n'ajoutez pas un second fournisseur.
AI_PROVIDER=anthropic

# Clé API Anthropic (console.anthropic.com). Sans elle, l'assistant reste en
# mode dégradé : recherche FAQ déterministe, sans appel réseau ni erreur —
# voir server/api/assistant/chat.post.ts.
ANTHROPIC_API_KEY=

# Modèles utilisés pour maîtriser les coûts (#geoloc, 2.3) : un modèle léger
# pour les questions simples (FAQ/navigation), un modèle plus capable
# seulement pour les demandes de recommandation (voir server/utils/ai/router.ts).
# Valeurs par défaut déjà appliquées si ces variables sont omises.
AI_MODEL_LIGHT=claude-haiku-4-5-20251001
AI_MODEL_HEAVY=claude-sonnet-5

# --- Instrumentation d'erreurs en production (#262) ---
# Sentry (ou équivalent auto-hébergé compatible, ex. GlitchTip) : voir
# docs/decisions/0009-instrumentation-erreurs-production.md. Sans ces
# valeurs, l'instrumentation reste entièrement inerte (aucun appel réseau) —
# server/utils/errorReporting.ts et app/plugins/errorReporting.client.ts.
# SENTRY_DSN : DSN du projet serveur (jamais exposé au client).
SENTRY_DSN=
# NUXT_PUBLIC_SENTRY_DSN : DSN du projet client (public par nature, comme
# tout DSN Sentry envoyé au navigateur — peut être identique à SENTRY_DSN).
NUXT_PUBLIC_SENTRY_DSN=
