# Variables du front statique. Copier vers `.env` pour le développement web.
# Les secrets et la base de données sont exclusivement configurés dans
# `backend/.env` (copier `backend/.env.example`).

# Adresse publique sans barre oblique finale, utilisée pour les balises SEO.
NUXT_PUBLIC_SITE_URL=

# DSN Sentry navigateur (optionnel et public par nature).
NUXT_PUBLIC_SENTRY_DSN=

# Parcours d'abonnement prestataire (formules, /abonnement, /paiement).
# Masqué par défaut ; mettre `true` pour le réafficher.
NUXT_PUBLIC_SUBSCRIPTION_ENABLED=false

# Cible du proxy Nuxt uniquement en développement. Laisser vide pour Express
# lancé localement sur le port 3001.
NUXT_DEV_API_PROXY_TARGET=
